# Copie para .env e ajuste. O arquivo .env não é versionado.

# Portas publicadas em 127.0.0.1
WEB_PORT=8080
API_PORT=8081
DB_PORT=5433

# Banco de dados
DB_NAME=cadastro
DB_USER=cadastro
DB_PASSWORD=

# Sessão de cadastro: minutos de inatividade até expirar
SESSAO_EXPIRACAO_MINUTOS=30
# Use true quando a aplicação estiver atrás de HTTPS
SESSAO_COOKIE_SEGURO=false
# Origens extras aceitas por CORS, separadas por vírgula. Vazio aceita só a mesma origem.
CORS_ORIGENS=

# Limites de uso (hipóteses iniciais, ajuste após medir)
LIMITE_RESPOSTAS_POR_SESSAO=60
LIMITE_RESPOSTAS_POR_MINUTO=10
LIMITE_REQUISICOES_POR_ORIGEM_POR_MINUTO=120

# Assistência por IA: qualquer API compatível com Chat Completions.
# A chave existe só no backend. Vazia, o cadastro segue com perguntas estruturadas.
LLM_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=350
